TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_CHAT_ID=123456789

# Binance Spot WebSocket market data only. No REST market-data polling.
BINANCE_WS_URL=wss://stream.binance.com:443
INTERVAL=5m

# Balanced Momentum Explosion settings
LOOKBACK=20
MIN_SCORE=48
VOL_MULT=2.0
RANGE_MULT=1.5
MAX_RANGE_ATR=5.0
MAX_EXT_ATR=3.5
MIN_BODY=0.55
CLOSE_LOC=0.70
MIN_AVG_QVOL=12000
RSI_MIN=58
RSI_MAX=82
ALLOW_SHORT=true

# Risk and alert controls
SL_ATR=1.8
RR1=1.5
RR2=3.0
COOLDOWN_MIN=0
SEND_STARTUP=false
